# Backend Server Configuration
PORT=8001
HOST=127.0.0.1

# Deepgram API Key for Speech-to-Text service
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key for Text-to-Speech service
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Key (optional fallback for LLM response)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (primary/fallback for LLM response)
GEMINI_API_KEY=your_gemini_api_key_here

# Database configuration (relative path for local SQLite development)
DATABASE_URL="file:./dev.db"

# JWT configuration (secure strings for authentication tokens)
JWT_ACCESS_SECRET="generate_a_long_random_string_here_for_access_secret"
JWT_REFRESH_SECRET="generate_a_long_random_string_here_for_refresh_secret"