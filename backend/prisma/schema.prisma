generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  entries      Entry[]
  insights     Insight[]
}

model Entry {
  id              String                      @id @default(uuid())
  userId          String
  transcript      String
  mrbrownResponse String?
  audioUrl        String?
  duration      Int?
  moodScore     Int?
  moodLabel     String?
  moodReason    String?
  createdAt     DateTime                    @default(now())
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  embedding     Unsupported("vector(768)")?
}

model Insight {
  id         String   @id @default(uuid())
  userId     String
  weekStart  DateTime
  weekEnd    DateTime
  summary    String
  themes     Json
  moodArc    String
  highlight  String
  suggestion String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
